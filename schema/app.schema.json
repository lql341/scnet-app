{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SCNet application description v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "upstream", "target", "scnet", "resources", "environment", "run", "check", "files", "acceptance"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "pattern": "^scnet-[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "upstream": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "target": {"enum": ["hygon-z100", "hygon-c86"]},
    "scnet": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "cluster", "region", "queue"],
      "properties": {
        "backend": {"const": "openapi"},
        "cluster": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"},
        "region": {"type": "string", "pattern": "^[0-9]+$"},
        "queue": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["nodes", "cpus", "dcus_per_node", "walltime"],
      "properties": {
        "nodes": {"type": "integer", "const": 1},
        "cpus": {"type": "integer", "minimum": 1},
        "dcus_per_node": {"type": "integer", "minimum": 0},
        "walltime": {"type": "string", "pattern": "^[0-9]+:[0-5][0-9]:[0-5][0-9]$"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["modules", "modulefiles"],
      "properties": {
        "modules": {"type": "array", "items": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/+:-]*$"}},
        "modulefiles": {"type": "string"}
      }
    },
    "stack": {
      "type": "object", "additionalProperties": false,
      "required": ["system", "toolchain", "backend", "mpi", "framework", "platform"],
      "properties": {
        "system": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "glibc"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "glibc": {"type": "string", "minLength": 1}
          }
        },
        "toolchain": {
          "type": "object", "additionalProperties": false,
          "required": ["gcc", "cmake"],
          "properties": {
            "gcc": {"type": "string", "minLength": 1},
            "cmake": {"type": "string", "minLength": 1}
          }
        },
        "backend": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "runtime", "version", "target", "arch"],
          "properties": {
            "kind": {"enum": ["dcu", "cuda", "cpu"]},
            "runtime": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1},
            "arch": {"type": "string", "minLength": 1}
          }
        },
        "mpi": {
          "type": "object", "additionalProperties": false,
          "required": ["vendor", "version"],
          "properties": {
            "vendor": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "framework": {
          "type": "object", "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1}
          }
        },
        "platform": {
          "type": "object", "additionalProperties": false,
          "required": ["adapter", "region", "cluster", "queue"],
          "properties": {
            "adapter": {"type": "string", "minLength": 1},
            "region": {"type": "string", "minLength": 1},
            "cluster": {"type": "string", "minLength": 1},
            "queue": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "prerequisites": {
      "type": "object", "additionalProperties": false,
      "required": ["modules", "conflicts", "obtain"],
      "properties": {
        "modules": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "obtain": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["criterion_version", "standard_suites"],
      "properties": {
        "criterion_version": {"type": "string", "minLength": 1},
        "standard_suites": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "device_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["artifact", "patterns"],
          "properties": {
            "artifact": {"type": "string", "minLength": 1},
            "patterns": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "run": {"type": "string"},
    "check": {"type": "string"},
    "files": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["revision", "license"],
      "properties": {"revision": {"type": "string"}, "license": {"type": "string"}}
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_nodes", "max_cpus", "max_dcus_per_node", "max_walltime"],
      "properties": {
        "max_nodes": {"type": "integer", "minimum": 1},
        "max_cpus": {"type": "integer", "minimum": 1},
        "max_dcus_per_node": {"type": "integer", "minimum": 0},
        "max_walltime": {"type": "string", "pattern": "^[0-9]+:[0-5][0-9]:[0-5][0-9]$"}
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "kind", "required"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
          "kind": {"enum": ["numeric", "hook"]},
          "required": {"type": "boolean"},
          "holdout": {"type": "boolean"},
          "file": {"type": "string", "minLength": 1},
          "key": {"type": "string", "minLength": 1},
          "ref": {"type": "number"},
          "atol": {"type": "number"},
          "rtol": {"type": "number"},
          "criterion": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
